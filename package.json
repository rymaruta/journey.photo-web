{
  "name": "photo-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-static-build.js",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "verify:visibility:live": "node scripts/verify-visibility-live.mjs",
    "upload-local-images": "tsx scripts/upload-local-images-to-s3.ts",
    "dev:upload": "tsx scripts/upload-to-dev-s3.ts",
    "add-exif": "tsx scripts/add-exif-to-existing-photos.ts",
    "api:info:prod": "cd api && npx serverless info --stage prod",
    "web:deploy:prod": "node scripts/deploy-static-site.js --bucket prod-journey-photo.com",
    "verify": "bash scripts/verify-local.sh"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1178.0",
    "@aws-sdk/client-cloudfront": "^3.1178.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1178.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1178.0",
    "@aws-sdk/client-dynamodb": "^3.1178.0",
    "@aws-sdk/client-iam": "^3.1178.0",
    "@aws-sdk/client-lambda": "^3.1178.0",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "@aws-sdk/client-sesv2": "^3.1178.0",
    "@aws-sdk/client-ssm": "^3.1178.0",
    "@aws-sdk/client-sts": "^3.1178.0",
    "@aws-sdk/lib-dynamodb": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@heroicons/react": "^2.2.0",
    "amazon-cognito-identity-js": "^6.3.22",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "lodash.debounce": "^4.0.8",
    "mime-types": "^3.0.2",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.23",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
